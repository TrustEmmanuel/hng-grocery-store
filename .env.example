# Public browser config. Vite only exposes variables prefixed with VITE_.
# The Supabase anon key is meant for the browser. Writes are blocked by RLS;
# orders and user records go through Edge Functions using the service role.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Do not put Mailgun or the Supabase service role here.
# Those belong in Supabase Edge Function secrets. See README.md.
